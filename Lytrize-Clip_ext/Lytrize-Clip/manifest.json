{
  "manifest_version": 3,
  "name": "Lytrize-Clip",
  "version": "1.0.0",
  "description": "Capture full-page screenshots of rendered pages without viewport stitching or scrolling.",
  "permissions": [
    "debugger",
    "activeTab",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  }
}
